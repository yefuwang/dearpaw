{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dearpaw",
  "workers_dev": false,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dearpaw-app",
      "database_id": "c686cf0a-d422-46eb-97f1-5ef8df0b1654",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "dearpaw-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "dearpaw-jobs"
      }
    ]
  },
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAEiWaOuBOic2Fvcm"
  }
}
