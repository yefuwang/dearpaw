---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Memorials We've Made | Dear Paw" description="A respectful gallery structure for Dear Paw memorial examples.">
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Gallery</p>
        <h1 class="display">Memorials we've made.</h1>
        <p class="lede">Real customer examples will appear here only with permission. These placeholders show the intended comparison format.</p>
      </div>
      <div class="comparison">
        <article class="comparison-item">
          <div class="comparison-visual"></div>
          <h3>Photo</h3>
          <p>Customer-supplied reference photos.</p>
        </article>
        <article class="comparison-item">
          <div class="comparison-visual"></div>
          <h3>Proof</h3>
          <p>The portrait approved before carving.</p>
        </article>
        <article class="comparison-item">
          <div class="comparison-visual"></div>
          <h3>Finished memorial</h3>
          <p>The final carved wood object.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

