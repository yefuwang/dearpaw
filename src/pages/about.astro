---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Dear Paw" description="Dear Paw's design philosophy for custom wooden pet memorials.">
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="display">Every animal looks different. Their memorial should too.</h1>
      </div>
      <div>
        <p class="lede">Dear Paw exists for people who want something more personal than a standard urn with a name on it.</p>
        <p>Photographs preserve the details that made a companion recognizable. Thoughtful carving can turn those details into a permanent object that belongs in the home.</p>
        <p>We do not invent workshop claims or production promises before they are true. The brand is built around restraint, clarity, and respect.</p>
      </div>
    </div>
  </section>
</BaseLayout>

