---
import { processSteps } from "../data/site";
---

<div class="process">
  {
    processSteps.map((step, index) => (
      <article class="step">
        <span class="step-index">{String(index + 1).padStart(2, "0")}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </article>
    ))
  }
</div>

